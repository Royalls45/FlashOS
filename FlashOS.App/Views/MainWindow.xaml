<Window x:Class="FlashOS.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FlashOS" Width="1180" Height="760" Background="{StaticResource BgBrush}" Foreground="#E2E8F0" WindowStartupLocation="CenterScreen">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="FLASHOS" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Анализатор загрузочных накопителей" Foreground="#94A3B8"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,25,0,16"><Button Content="↻  Обновить накопители" Command="{Binding RefreshCommand}"/><Button Content="⌕  Сканировать выбранный" Command="{Binding ScanCommand}"/><Button Content="▶  Запустить ISO через QEMU" Command="{Binding LaunchCommand}"/><TextBlock Text="{Binding AnalysisStatus}" VerticalAlignment="Center" Foreground="#94A3B8"/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,14,0"><StackPanel><TextBlock Text="НАКОПИТЕЛИ" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/><ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Label" Height="180"/><TextBlock Text="Выберите съёмный накопитель для поиска ISO и конфигураций." TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,15,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="СОДЕРЖИМОЕ НАКОПИТЕЛЯ" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Row="1" Text="{Binding PersistenceStatus}" Foreground="#FBBF24" Margin="0,12,0,10"/><ListView Grid.Row="2" ItemsSource="{Binding Files}" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="Тип" DisplayMemberBinding="{Binding TypeLabel}" Width="190"/><GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="300"/><GridViewColumn Header="Путь" DisplayMemberBinding="{Binding Path}" Width="420"/></GridView></ListView.View></ListView></Grid></Border></Grid>
<Border Grid.Row="3" Background="#0B1220" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="ЖУРНАЛ СОБЫТИЙ" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"/></StackPanel></Border>
</Grid></Window>
